# Optional live-test inputs. Copy to .env.test and fill in private values.
# Load with Node 22's --env-file=.env.test; no dotenv dependency is required.
SLACK_TEST_CHANNEL_ID=
SLACK_PIPA_BOT_USER_ID=
SLACK_USER_TOKEN=
# Separate Pipa profile home for the candidate; configure its app credentials privately.
PIPA_HOME=
# Attest only after checking the chosen app has no other Socket consumer.
PIPA_TEST_SOLE_CONSUMER=
# Exact native server URL and pin for read-only authenticated readiness checks.
# Owned servers use their current listening URL; refresh after a restart.
PIPA_TEST_ENGINE_URL=
PIPA_TEST_ENGINE_PIN=
# Optional installed candidate's absolute bin/pipa.mjs; defaults to this checkout.
PIPA_TEST_CLI=
# Optional bot sender, distinct from Pipa. SLACK_USER_TOKEN still reads history.
SLACK_SENDER_BOT_TOKEN=
# Provider/model is selected in the private OpenCode config, not by the evaluator.
# Attached mode also requires PIPA_OPENCODE_ATTACH_URL and native credentials.
